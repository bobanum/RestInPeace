{
  "name": "bobanum/restinpeace",
  "description": "Database-Driven REST API Module with HATEOAS Support",
  "require": {
    "php": ">=7.4.33",
    "doctrine/inflector": "^2.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "RestInPeace\\": "src/",
      "RestInPeace\\Models\\": "../../../models/",
      "RestInPeace\\Models\\Traits\\": "../../../traits/"
    }
  },
  "authors": [
    {
      "name": "Martin Boudreau",
      "email": "bobanum@gmail.com"
    }
  ],
  "homepage": "https://githhub.com/bobanum/RestInPeace",
  "support": {
    "email": "support.email@example.com",
    "issues": "https://github.com/bobanum/RestInPeace/issues",
    "source": "https://github.com/bobanum/RestInPeace"
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "scripts": {
    "post-install-cmd": [
      "php scripts/inject-autoload.php"
    ],
    "post-update-cmd": [
      "php scripts/inject-autoload.php"
    ]
  }
}